# ── Serveur ────────────────────────────────────────────────────────────────────
# PORT est fourni automatiquement par Render (10000 par défaut) — ne pas le fixer en prod.
PORT=3000
# production en prod, development en local
NODE_ENV=development
# Origines autorisées (séparées par une virgule), ex : https://roogo-frontend.onrender.com
CORS_ORIGIN=http://localhost:4200

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=roogo_db
# true si le serveur PostgreSQL exige SSL (Render Postgres, Neon, Supabase, …)
DB_SSL=false

# ── JWT ────────────────────────────────────────────────────────────────────────
# ⚠ JAMAIS un vrai secret ici : ce fichier est versionné dans un dépôt PUBLIC
# (tout ce qui est commité est lisible par tout le monde, même après un retrait).
# Mettre la vraie clé dans roogo-backend/.env (ignoré par git) et dans le
# dashboard Render (Environment → JWT_SECRET). Générer une valeur avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=placeholder_ajouter_une_cle_aleatoire

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
